// SLMK-BRIDGE v1.1 — Stateful bidirectional bridge for SL MkIII <-> AUM
//
// Runs as a Mozaic AUv3 on the iDAM MIDI path. Mac controls it via sysex.
// Sits between iDAM input and the AUM MIDI mapping/plugin chain.
//
// Wire protocol (F0 7D = non-commercial / private manufacturer ID).
// Single-byte command opcodes.
//
// Mac -> bridge (requests):
//   00 HELLO                    handshake
//   01 GET_VALUES               replay every cached watched CC value
//   02 WATCH_CC ch cc [...]     add (ch, cc) pairs to CC watch set
//   03 WATCH_NOTES ch [...]     enable note echoing on listed channels
//   04 CLEAR_WATCHES            forget all CC and note watches
//   05 PAGE page                set active page (echo state, no routing yet)
//
// bridge -> Mac (responses / events):
//   10 HELLO_ACK major minor    sent in reply to HELLO and at @OnLoad
//   11 CC_VALUE ch cc val       echoed CC value (only on actual change)
//   12 NOTE_ON ch note vel      echoed note-on
//   13 NOTE_OFF ch note         echoed note-off
//   15 PAGE_ACK page            confirmation of page change

@OnLoad
    SetShortName {SLMK-BR}
    ShowLayout 0
    LabelPads {SLMK-BRIDGE v1.1 - dynamic stateful bridge for SL MkIII feedback}
    Log {SLMK-BRIDGE v1.1 loaded}

    // Watch set: 16 channels × 128 CCs flat array. 1 = watched.
    FillArray watch_mask, 0, 2048
    // Per-channel note echo flags
    FillArray note_watch, 0, 16
    // Value cache: -1 means "no value seen yet" (so first arrival always emits)
    FillArray cc_values, -1, 2048

    active_page = 0
    proto_major = 1
    proto_minor = 1

    // Constants
    sx_start = 0xF0
    sx_tag   = 0x7D
    sx_end   = 0xF7

    // Request opcodes
    cmd_hello       = 0x00
    cmd_get_values  = 0x01
    cmd_watch_cc    = 0x02
    cmd_watch_notes = 0x03
    cmd_clear       = 0x04
    cmd_page        = 0x05

    // Response opcodes
    rsp_hello_ack = 0x10
    rsp_cc_value  = 0x11
    rsp_note_on   = 0x12
    rsp_note_off  = 0x13
    rsp_page_ack  = 0x15

    // Announce ourselves so a Mac listening on startup learns we're here
    Call @SendHelloAck
@End

@OnMidiCC
    // Pass through to AUM's MIDI mapping / next plugin in chain
    SendMIDICC MIDIChannel, MIDIByte2, MIDIByte3

    idx = MIDIChannel * 128 + MIDIByte2
    if watch_mask[idx] = 1
        // Dedup: only emit when the value actually changed
        if cc_values[idx] <> MIDIByte3
            cc_values[idx] = MIDIByte3
            Call @EmitCCValue
        endif
    endif
@End

@OnMidiNote
    if MIDICommand = 0x90
        SendMIDINoteOn MIDIChannel, MIDIByte2, MIDIByte3
        if note_watch[MIDIChannel] = 1
            Call @EmitNoteOn
        endif
    elseif MIDICommand = 0x80
        SendMIDINoteOff MIDIChannel, MIDIByte2, MIDIByte3
        if note_watch[MIDIChannel] = 1
            Call @EmitNoteOff
        endif
    endif
@End

@OnSysex
    ReceiveSysex rx
    // Smallest valid private message is F0 7D cmd F7 = 4 bytes
    if SysexSize < 4
        Exit
    endif
    if rx[0] <> sx_start
        Exit
    endif
    if rx[1] <> sx_tag
        Exit
    endif

    cmd = rx[2]

    if cmd = cmd_hello
        Call @SendHelloAck
    elseif cmd = cmd_get_values
        Call @ReplayValues
    elseif cmd = cmd_watch_cc
        Call @HandleWatchCC
    elseif cmd = cmd_watch_notes
        Call @HandleWatchNotes
    elseif cmd = cmd_clear
        Call @HandleClear
    elseif cmd = cmd_page
        Call @HandlePage
    endif
@End

@SendHelloAck
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_hello_ack
    sysex_msg[3] = proto_major
    sysex_msg[4] = proto_minor
    sysex_msg[5] = sx_end
    SendSysex sysex_msg, 6
@End

@EmitCCValue
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_cc_value
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = MIDIByte3
    sysex_msg[6] = sx_end
    SendSysex sysex_msg, 7
@End

@EmitNoteOn
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_note_on
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = MIDIByte3
    sysex_msg[6] = sx_end
    SendSysex sysex_msg, 7
@End

@EmitNoteOff
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_note_off
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = sx_end
    SendSysex sysex_msg, 6
@End

@ReplayValues
    // Walk every watched cell; emit cached value if known.
    // 2048 iterations in Mozaic is well under a millisecond.
    for ch = 0 to 15
        for cc = 0 to 127
            idx = ch * 128 + cc
            if watch_mask[idx] = 1
                if cc_values[idx] >= 0
                    sysex_msg[0] = sx_start
                    sysex_msg[1] = sx_tag
                    sysex_msg[2] = rsp_cc_value
                    sysex_msg[3] = ch
                    sysex_msg[4] = cc
                    sysex_msg[5] = cc_values[idx]
                    sysex_msg[6] = sx_end
                    SendSysex sysex_msg, 7
                endif
            endif
        endfor
    endfor
@End

@HandleWatchCC
    // Payload: pairs of (ch, cc) starting at byte 3, ending before F7
    i = 3
    end_i = SysexSize - 1
    added = 0
    while (i < end_i)
        ch = rx[i]
        cc = rx[i + 1]
        if ch < 16
            if cc < 128
                idx = ch * 128 + cc
                watch_mask[idx] = 1
                added = added + 1
            endif
        endif
        i = i + 2
    endwhile
    Log {WATCH_CC +}, added
@End

@HandleWatchNotes
    // Payload: list of channel numbers (0-15)
    i = 3
    end_i = SysexSize - 1
    added = 0
    while (i < end_i)
        ch = rx[i]
        if ch < 16
            note_watch[ch] = 1
            added = added + 1
        endif
        i = i + 1
    endwhile
    Log {WATCH_NOTES +}, added
@End

@HandleClear
    FillArray watch_mask, 0, 2048
    FillArray note_watch, 0, 16
    FillArray cc_values, -1, 2048
    Log {CLEAR_WATCHES}
@End

@HandlePage
    if SysexSize >= 5
        active_page = rx[3]
        // Echo back so Mac can confirm we received it
        sysex_msg[0] = sx_start
        sysex_msg[1] = sx_tag
        sysex_msg[2] = rsp_page_ack
        sysex_msg[3] = active_page
        sysex_msg[4] = sx_end
        SendSysex sysex_msg, 5
        Log {PAGE = }, active_page
    endif
@End
