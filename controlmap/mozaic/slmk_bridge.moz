// SLMK-BRIDGE v1.2 — Stateful bidirectional bridge for SL MkIII <-> AUM
//
// Runs as a Mozaic AUv3 on the iDAM MIDI path. Mac controls it via sysex.
// Sits between iDAM input and the AUM MIDI mapping/plugin chain.
//
// v1.2 adds: per-page CC routing, scenes, health metrics.
//
// Wire protocol (F0 7D = non-commercial / private manufacturer ID).
// Single-byte command opcodes.
//
// Mac -> bridge (requests):
//   00 HELLO                                            handshake
//   01 GET_VALUES                                       replay every cached watched CC
//   02 WATCH_CC ch cc [...]                             add (ch, cc) pairs to CC watch set
//   03 WATCH_NOTES ch [...]                             enable note echoing on listed channels
//   04 CLEAR_WATCHES                                    forget all CC and note watches
//   05 PAGE page                                        set active page
//   06 GET_HEALTH                                       request health snapshot
//   07 ROUTE_SET page in_ch in_cc out_ch out_cc [...]   add per-page CC route(s)
//   08 ROUTE_CLEAR                                      forget all routes
//   09 SCENE_SAVE scene                                 snapshot current cc_values into a scene
//   0A SCENE_RECALL scene                               replay a scene as outbound CCs
//
// bridge -> Mac (responses / events):
//   10 HELLO_ACK major minor                            also sent at @OnLoad
//   11 CC_VALUE ch cc val                               on actual change
//   12 NOTE_ON ch note vel
//   13 NOTE_OFF ch note
//   14 HEALTH msg_in_hi msg_in_lo msg_out_hi msg_out_lo route_count scene_mask
//   15 PAGE_ACK page

@OnLoad
    SetShortName {SLMK-BR}
    ShowLayout 0
    LabelPads {SLMK-BRIDGE v1.2 - dynamic stateful bridge w/ routes, scenes, health}
    Log {SLMK-BRIDGE v1.2 loaded}

    // Watch set: 16 channels × 128 CCs flat array. 1 = watched.
    FillArray watch_mask, 0, 2048
    // Sparse mirror of watch_mask: linear list of packed (ch<<7|cc) indices
    // so GET_VALUES only iterates watched cells, not all 2048.
    FillArray watch_list, 0, 256
    watch_list_count = 0
    // Per-channel note echo flags
    FillArray note_watch, 0, 16
    // Value cache: -1 means "no value seen yet" (so first arrival always emits)
    FillArray cc_values, -1, 2048

    // Routes: sparse parallel arrays. (page, in_ch, in_cc) -> (out_ch, out_cc)
    FillArray route_page,   -1, 256
    FillArray route_in_ch,  -1, 256
    FillArray route_in_cc,  -1, 256
    FillArray route_out_ch, -1, 256
    FillArray route_out_cc, -1, 256
    route_count = 0

    // Scenes: 8 scenes × up to 64 (ch, cc, val) entries each
    FillArray scene_count, 0, 8         // entries per scene
    FillArray scene_data,  0, 1536      // 8 scenes × 64 entries × 3 fields (ch, cc, val)

    active_page = 0
    proto_major = 1
    proto_minor = 2

    // Health counters (split into 7-bit halves for sysex transport)
    msg_in_count = 0
    msg_out_count = 0

    // Constants
    sx_start = 0xF0
    sx_tag   = 0x7D
    sx_end   = 0xF7

    // Request opcodes
    cmd_hello       = 0x00
    cmd_get_values  = 0x01
    cmd_watch_cc    = 0x02
    cmd_watch_notes = 0x03
    cmd_clear_watches       = 0x04
    cmd_page        = 0x05
    cmd_get_health  = 0x06
    cmd_route_set   = 0x07
    cmd_route_clear = 0x08
    cmd_scene_save  = 0x09
    cmd_scene_recall = 0x0A

    // Response opcodes
    rsp_hello_ack = 0x10
    rsp_cc_value  = 0x11
    rsp_note_on   = 0x12
    rsp_note_off  = 0x13
    rsp_health    = 0x14
    rsp_page_ack  = 0x15

    Call @SendHelloAck
@End

@OnMidiCC
    msg_in_count = msg_in_count + 1

    // Per-page route lookup: if (active_page, MIDIChannel, MIDIByte2) has a
    // route, transform and emit on the routed (ch, cc) instead of pass-through.
    routed = 0
    i = 0
    while (i < route_count)
        if route_page[i] = active_page
            if route_in_ch[i] = MIDIChannel
                if route_in_cc[i] = MIDIByte2
                    SendMIDICC route_out_ch[i], route_out_cc[i], MIDIByte3
                    msg_out_count = msg_out_count + 1
                    routed = 1
                endif
            endif
        endif
        i = i + 1
    endwhile

    if routed = 0
        SendMIDICC MIDIChannel, MIDIByte2, MIDIByte3
        msg_out_count = msg_out_count + 1
    endif

    idx = MIDIChannel * 128 + MIDIByte2
    if watch_mask[idx] = 1
        if cc_values[idx] <> MIDIByte3
            cc_values[idx] = MIDIByte3
            Call @EmitCCValue
        endif
    endif
@End

@OnMidiNote
    msg_in_count = msg_in_count + 1
    if MIDICommand = 0x90
        SendMIDINoteOn MIDIChannel, MIDIByte2, MIDIByte3
        msg_out_count = msg_out_count + 1
        if note_watch[MIDIChannel] = 1
            Call @EmitNoteOn
        endif
    elseif MIDICommand = 0x80
        SendMIDINoteOff MIDIChannel, MIDIByte2, MIDIByte3
        msg_out_count = msg_out_count + 1
        if note_watch[MIDIChannel] = 1
            Call @EmitNoteOff
        endif
    endif
@End

@OnSysex
    ReceiveSysex rx
    if SysexSize < 4
        Exit
    endif
    if rx[0] <> sx_start
        Exit
    endif
    if rx[1] <> sx_tag
        Exit
    endif

    cmd = rx[2]

    if cmd = cmd_hello
        Call @SendHelloAck
    elseif cmd = cmd_get_values
        Call @ReplayValues
    elseif cmd = cmd_watch_cc
        Call @HandleWatchCC
    elseif cmd = cmd_watch_notes
        Call @HandleWatchNotes
    elseif cmd = cmd_clear_watches
        Call @HandleClear
    elseif cmd = cmd_page
        Call @HandlePage
    elseif cmd = cmd_get_health
        Call @HandleGetHealth
    elseif cmd = cmd_route_set
        Call @HandleRouteSet
    elseif cmd = cmd_route_clear
        Call @HandleRouteClear
    elseif cmd = cmd_scene_save
        Call @HandleSceneSave
    elseif cmd = cmd_scene_recall
        Call @HandleSceneRecall
    endif
@End

@SendHelloAck
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_hello_ack
    sysex_msg[3] = proto_major
    sysex_msg[4] = proto_minor
    sysex_msg[5] = sx_end
    SendSysex sysex_msg, 6
@End

@EmitCCValue
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_cc_value
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = MIDIByte3
    sysex_msg[6] = sx_end
    SendSysex sysex_msg, 7
@End

@EmitNoteOn
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_note_on
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = MIDIByte3
    sysex_msg[6] = sx_end
    SendSysex sysex_msg, 7
@End

@EmitNoteOff
    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_note_off
    sysex_msg[3] = MIDIChannel
    sysex_msg[4] = MIDIByte2
    sysex_msg[5] = sx_end
    SendSysex sysex_msg, 6
@End

@ReplayValues
    for k = 0 to watch_list_count - 1
        idx = watch_list[k]
        if cc_values[idx] >= 0
            sysex_msg[0] = sx_start
            sysex_msg[1] = sx_tag
            sysex_msg[2] = rsp_cc_value
            sysex_msg[3] = idx / 128
            sysex_msg[4] = idx % 128
            sysex_msg[5] = cc_values[idx]
            sysex_msg[6] = sx_end
            SendSysex sysex_msg, 7
        endif
    endfor
@End

@HandleWatchCC
    i = 3
    end_i = SysexSize - 1
    added = 0
    while (i < end_i)
        ch = rx[i]
        cc = rx[i + 1]
        if ch < 16
            if cc < 128
                idx = ch * 128 + cc
                if watch_mask[idx] = 0
                    watch_mask[idx] = 1
                    if watch_list_count < 256
                        watch_list[watch_list_count] = idx
                        watch_list_count = watch_list_count + 1
                    endif
                    added = added + 1
                endif
            endif
        endif
        i = i + 2
    endwhile
    Log {WATCH_CC +}, added
@End

@HandleWatchNotes
    i = 3
    end_i = SysexSize - 1
    added = 0
    while (i < end_i)
        ch = rx[i]
        if ch < 16
            note_watch[ch] = 1
            added = added + 1
        endif
        i = i + 1
    endwhile
    Log {WATCH_NOTES +}, added
@End

@HandleClear
    FillArray watch_mask, 0, 2048
    FillArray watch_list, 0, 256
    watch_list_count = 0
    FillArray note_watch, 0, 16
    FillArray cc_values, -1, 2048
    Log {CLEAR_WATCHES}
@End

@HandlePage
    if SysexSize >= 5
        active_page = rx[3]
        sysex_msg[0] = sx_start
        sysex_msg[1] = sx_tag
        sysex_msg[2] = rsp_page_ack
        sysex_msg[3] = active_page
        sysex_msg[4] = sx_end
        SendSysex sysex_msg, 5
        Log {PAGE = }, active_page
    endif
@End

@HandleGetHealth
    // Pack 14-bit counts as (hi7, lo7) pairs. Saturating at 16383.
    in_h = msg_in_count / 128
    if in_h > 127
        in_h = 127
    endif
    in_l = msg_in_count % 128
    out_h = msg_out_count / 128
    if out_h > 127
        out_h = 127
    endif
    out_l = msg_out_count % 128

    // scene_mask: bit i set if scene_count[i] > 0. Limited to 7 bits.
    scene_mask = 0
    for i = 0 to 6
        if scene_count[i] > 0
            scene_mask = scene_mask + (1 << i)
        endif
    endfor

    sysex_msg[0] = sx_start
    sysex_msg[1] = sx_tag
    sysex_msg[2] = rsp_health
    sysex_msg[3] = in_h
    sysex_msg[4] = in_l
    sysex_msg[5] = out_h
    sysex_msg[6] = out_l
    sysex_msg[7] = route_count
    sysex_msg[8] = scene_mask
    sysex_msg[9] = sx_end
    SendSysex sysex_msg, 10
@End

@HandleRouteSet
    // Payload: groups of 5 bytes (page, in_ch, in_cc, out_ch, out_cc)
    i = 3
    end_i = SysexSize - 1
    added = 0
    while (i + 4 < end_i + 1)
        if route_count < 256
            route_page[route_count]   = rx[i]
            route_in_ch[route_count]  = rx[i + 1]
            route_in_cc[route_count]  = rx[i + 2]
            route_out_ch[route_count] = rx[i + 3]
            route_out_cc[route_count] = rx[i + 4]
            route_count = route_count + 1
            added = added + 1
        endif
        i = i + 5
    endwhile
    Log {ROUTE_SET +}, added
@End

@HandleRouteClear
    FillArray route_page,   -1, 256
    FillArray route_in_ch,  -1, 256
    FillArray route_in_cc,  -1, 256
    FillArray route_out_ch, -1, 256
    FillArray route_out_cc, -1, 256
    route_count = 0
    Log {ROUTE_CLEAR}
@End

@HandleSceneSave
    if SysexSize >= 5
        scene = rx[3]
        if scene < 8
            // Snapshot all watched CCs that have known values
            count = 0
            base = scene * 192   // 64 entries × 3 fields
            for ch = 0 to 15
                for cc = 0 to 127
                    if count < 64
                        idx = ch * 128 + cc
                        if watch_mask[idx] = 1
                            if cc_values[idx] >= 0
                                scene_data[base + count * 3]     = ch
                                scene_data[base + count * 3 + 1] = cc
                                scene_data[base + count * 3 + 2] = cc_values[idx]
                                count = count + 1
                            endif
                        endif
                    endif
                endfor
            endfor
            scene_count[scene] = count
            Log {SCENE_SAVE }, scene, { count=}, count
        endif
    endif
@End

@HandleSceneRecall
    if SysexSize >= 5
        scene = rx[3]
        if scene < 8
            count = scene_count[scene]
            base = scene * 192
            for i = 0 to count - 1
                ch  = scene_data[base + i * 3]
                cc  = scene_data[base + i * 3 + 1]
                val = scene_data[base + i * 3 + 2]
                SendMIDICC ch, cc, val
                msg_out_count = msg_out_count + 1
            endfor
            Log {SCENE_RECALL }, scene, { count=}, count
        endif
    endif
@End
