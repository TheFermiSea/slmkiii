// runtime_data_proto.moz — iPad validation TEST C
//
// Question: Does the Mozaic ↔ Mozaic private SysEx protocol round-trip
// correctly through AUM's MIDI matrix?
//
// This script simulates BOTH ends of the runtime↔data SysEx contract:
//   - On @OnLoad it sends a "request param 2" SysEx
//   - On @OnSysex receiving a request, it replies with the value at that idx
//   - On @OnSysex receiving a reply, it logs it
//
// Header: F0 7D 53 4C 4D 4B <cmd> <args> F7
//   cmd = 0x01 REQUEST  args = (idx)
//   cmd = 0x02 REPLY    args = (idx, value)
//
// 0x7D is the SysEx non-commercial / educational manufacturer ID — carved
// out for exactly this kind of in-house protocol, no risk of collision
// with InControl (00 20 29).
//
// HOW TO USE:
//   1. Load TWO instances of Mozaic in AUM, both running this script,
//      with each output routed to the other's input. (This proves
//      cross-instance routing.)
//   2. After load, watch each instance's Log:
//        Instance A: "requested idx=2"
//        Instance B: "got request idx=2, replying with 127"  (or whatever)
//        Instance A: "got reply idx=2 val=127"
//
// EXPECTED PASS:
//   "requested idx=2" then "got reply idx=2 val=127"
//
// EXPECTED FAILURE MODES:
//   - @OnSysex never fires: AUM is not routing SysEx between instances.
//     Check matrix; route Mozaic instance A output -> Mozaic instance B input
//     and vice versa. Document the routing diagram in RESULTS.md.
//   - Reply value is wrong: byte ordering or idx encoding mismatch — should
//     not happen but flag immediately.

@OnLoad
    SetShortName {RTPROTO}

    // Simulated "data table" populated locally
    data[0]=0x40  data[1]=0x55  data[2]=0x7F  data[3]=0x01

    // Send a request for index 2
    target_idx = 2
    sx[0]=0xF0
    sx[1]=0x7D
    sx[2]=0x53  // 'S'
    sx[3]=0x4C  // 'L'
    sx[4]=0x4D  // 'M'
    sx[5]=0x4B  // 'K'
    sx[6]=0x01  // REQUEST
    sx[7]=target_idx
    sx[8]=0xF7
    SendSysex sx, 9
    Log {requested idx=}, target_idx
@End

@OnSysex
    // Validate header (F0 7D 53 4C 4D 4B)
    if SysexByte0 = 0xF0 and SysexByte1 = 0x7D and SysexByte2 = 0x53 and SysexByte3 = 0x4C and SysexByte4 = 0x4D and SysexByte5 = 0x4B
        cmd = SysexByte6
        if cmd = 0x01
            // REQUEST: reply with the value at the requested idx
            idx = SysexByte7
            val = data[idx]
            Log {got request idx=}, idx, {, replying with }, val
            rep[0]=0xF0
            rep[1]=0x7D
            rep[2]=0x53
            rep[3]=0x4C
            rep[4]=0x4D
            rep[5]=0x4B
            rep[6]=0x02
            rep[7]=idx
            rep[8]=val
            rep[9]=0xF7
            SendSysex rep, 10
        elseif cmd = 0x02
            // REPLY: log it
            idx = SysexByte7
            val = SysexByte8
            Log {got reply idx=}, idx, { val=}, val
        endif
    endif
@End
