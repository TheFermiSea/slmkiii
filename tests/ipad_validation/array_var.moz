// array_var.moz — iPad validation TEST A (revised: one stmt per line)
//
// Question: Does Mozaic's `array[var]` indirect indexing work?
//
// On a PASS, the Log should show:
//     map[0] = 10
//     map[1] = 20
//     ...
//     map[7] = 80
//     direct map[3] via var = 40
//     map[j+1] via expr = 50
//
// Then sending CC#20 val=0..7 should print:
//     CC val=N -> map[N] = N*10+10

@OnLoad
    SetShortName {ARRTEST}
    map[0] = 10
    map[1] = 20
    map[2] = 30
    map[3] = 40
    map[4] = 50
    map[5] = 60
    map[6] = 70
    map[7] = 80
    Log {-- array[var] test --}
    for i = 0 to 7
        v = map[i]
        Log {map[}, i, {] = }, v
    endfor
    j = 3
    direct = map[j]
    Log {direct map[3] via var = }, direct
    expr = map[j+1]
    Log {map[j+1] via expr = }, expr
@End

@OnMidiCC
    if MIDIByte2 = 20
        idx = MIDIByte3 % 8
        out = map[idx]
        Log {CC val=}, MIDIByte3, { -> map[}, idx, {] = }, out
    endif
@End
