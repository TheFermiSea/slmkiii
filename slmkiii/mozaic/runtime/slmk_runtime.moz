// SLMK Runtime — single-instance template, version 2.0.0
//
// Hand-written + slot for codegen-injected binding tables. The Python
// emitter (slmkiii/mozaic/emit_data.py) splices a `<spec>`-specific block
// of array assignments into the marker line below, producing one
// self-contained `slmk_<spec>.moz` file.
//
// Why single-instance: cross-instance Mozaic-AUv3 SysEx routing in AUM
// is fundamentally unreliable (256-byte CoreMIDI packet limit, Mozaic's
// shared-timestamp SysEx bug, non-deterministic AUv3 ordering).
// Empirically verified on 2026-04-28: even a 3-byte SysEx with a no-op
// @OnSysex handler crashes the receiving Mozaic instance.
// See tests/ipad_validation/RESULTS.md for full evidence + citations.
//
// Capacity: 8 pages × 4 focus instances × (8 knobs + 8 faders + 16 pads).

@OnLoad
    SetShortName {SLMK RT}
    ShowLayout 2
    LabelPads {SLMK Runtime — see screens for live labels}

    // ---- Static SL MkIII protocol bytes (sourced from slmkiii.sysex) ----
    sl_ch=15                    // SL MkIII InControl ch16 (0-indexed)
    sl_knob_base=0x15
    sl_fader_base=0x29
    sl_softbtn_base=0x33
    sl_pad_base=0x60
    sl_pads_up=0x55
    sl_pads_down=0x56
    sl_track_left=0x66
    sl_track_right=0x67

    led_top_row_base=0x04
    led_2nd_row_base=0x0C
    led_pad_base=0x26
    led_fader_base=0x36

    col_off=0
    col_dim_white=1
    col_white=3
    col_red=5
    col_orange=9
    col_yellow=13
    col_green=21
    col_dim_green=23
    col_cyan=33
    col_blue=37
    col_purple=49

    active_page=0
    active_focus=0

    // ---- Initialise empty tables (codegen overwrites them below) ----
    FillArray page_color, 0, 8
    FillArray knob_ch, 0, 512
    FillArray knob_cc, 0, 512
    FillArray fader_ch, 0, 512
    FillArray fader_cc, 0, 512
    FillArray knob_val, 64, 512
    FillArray fader_val, 0, 512
    FillArray pad_ch, 0, 1024
    FillArray pad_note, 0, 1024
    FillArray pad_color, 0, 1024
    FillArray focus_count, 0, 8

    // ===================================================================
    // Codegen splices spec-specific data here:
    //   page_color[i] = ...
    //   focus_count[i] = ...
    //   knob_ch[idx] = ..., knob_cc[idx] = ...
    //   fader_ch[idx] = ..., fader_cc[idx] = ...
    //   pad_ch[idx] = ..., pad_note[idx] = ..., pad_color[idx] = ...
    //   n_pages = N
    // ===================================================================
    {{INLINE_DATA_TABLES}}

    Log {SLMK Runtime ready: }, n_pages, { pages}
    Call @RenderActivePage
@End

// ===========================================================================
// Hardware input -> CC/notes out + screen update
// ===========================================================================
@OnMidiCC
    if MIDIChannel <> sl_ch
        Exit
    endif
    cc=MIDIByte2
    val=MIDIByte3

    // KNOB DELTA (highest event volume — keep first)
    if cc >= sl_knob_base and cc < sl_knob_base + 8
        knob_idx=cc - sl_knob_base
        if knob_idx >= 4
            Exit
        endif
        Call @HandleKnobDelta
        Exit
    endif

    // FADER (absolute)
    if cc >= sl_fader_base and cc < sl_fader_base + 8
        fader_idx=cc - sl_fader_base
        if fader_idx >= 4
            Exit
        endif
        Call @HandleFader
        Exit
    endif

    // SOFT BUTTONS (page select / focus select)
    if cc >= sl_softbtn_base and cc < sl_softbtn_base + 16
        if val = 127
            Call @HandleSoftButton
        endif
        Exit
    endif

    // Track L/R
    if cc = sl_track_left and val = 127
        if active_page > 0
            active_page=active_page - 1
        else
            active_page=n_pages - 1
        endif
        active_focus=0
        Call @RenderActivePage
        Exit
    endif
    if cc = sl_track_right and val = 127
        active_page=active_page + 1
        if active_page >= n_pages
            active_page=0
        endif
        active_focus=0
        Call @RenderActivePage
        Exit
    endif

    // Pads up/down (focus nav within current page)
    if cc = sl_pads_up and val = 127
        if active_focus > 0
            active_focus=active_focus - 1
            Call @RenderActivePage
        endif
        Exit
    endif
    if cc = sl_pads_down and val = 127
        if active_focus + 1 < focus_count[active_page]
            active_focus=active_focus + 1
            Call @RenderActivePage
        endif
        Exit
    endif
@End

@HandleKnobDelta
    delta=val
    if delta > 63
        delta=delta - 128
    endif
    idx=(active_page*8 + active_focus)*8 + knob_idx
    out_ch=knob_ch[idx]
    out_cc=knob_cc[idx]
    if out_ch = 0
        Exit
    endif
    new_val=knob_val[idx] + delta
    if new_val < 0
        new_val=0
    endif
    if new_val > 127
        new_val=127
    endif
    if new_val = knob_val[idx]
        Exit
    endif
    knob_val[idx]=new_val
    SendMIDICC out_ch - 1, out_cc, new_val
    Call @UpdateKnobScreen
@End

@HandleFader
    idx=(active_page*8 + active_focus)*8 + fader_idx
    out_ch=fader_ch[idx]
    out_cc=fader_cc[idx]
    if out_ch = 0
        Exit
    endif
    if val = fader_val[idx]
        Exit
    endif
    fader_val[idx]=val
    SendMIDICC out_ch - 1, out_cc, val
    Call @UpdateFaderScreen
@End

@HandleSoftButton
    btn=cc - sl_softbtn_base
    if btn < 8
        if btn < n_pages
            active_page=btn
            active_focus=0
            Call @RenderActivePage
        endif
        Exit
    endif
    focus_btn=btn - 8
    if focus_btn < focus_count[active_page]
        active_focus=focus_btn
        Call @RenderActivePage
    endif
@End

// ===========================================================================
// Pads -> NoteOn/Off out
// ===========================================================================
@OnMidiNote
    if MIDIChannel <> sl_ch
        Exit
    endif
    if MIDIByte2 < sl_pad_base or MIDIByte2 >= sl_pad_base + 16
        Exit
    endif
    pad=MIDIByte2 - sl_pad_base
    idx=(active_page*8 + active_focus)*16 + pad
    out_ch=pad_ch[idx]
    out_note=pad_note[idx]
    if out_ch = 0
        Exit
    endif
    if MIDICommand = 0x90 and MIDIByte3 > 0
        SendMIDINoteOn out_ch - 1, out_note, MIDIByte3
        SendMIDINoteOn sl_ch, led_pad_base + pad, col_white
    elseif MIDICommand = 0x80 or (MIDICommand = 0x90 and MIDIByte3 = 0)
        SendMIDINoteOff out_ch - 1, out_note, 0
        SendMIDINoteOn sl_ch, led_pad_base + pad, pad_color[idx]
    endif
@End

// ===========================================================================
// Render — paints all 8 columns + LEDs for the active (page, focus)
// ===========================================================================
@RenderActivePage
    sx[0]=0xF0
    sx[1]=0x00
    sx[2]=0x20
    sx[3]=0x29
    sx[4]=0x02
    sx[5]=0x0A
    sx[6]=0x01
    sx[7]=0x01
    sx[8]=0x01
    sx[9]=0xF7
    SendSysex sx, 10

    for i = 0 to 7
        if i < n_pages
            if i = active_page
                SendMIDINoteOn sl_ch, led_top_row_base + i, page_color[i]
            else
                SendMIDINoteOn sl_ch, led_top_row_base + i, col_dim_white
            endif
        else
            SendMIDINoteOn sl_ch, led_top_row_base + i, col_off
        endif
    endfor

    for i = 0 to 7
        if i < focus_count[active_page]
            if i = active_focus
                SendMIDINoteOn sl_ch, led_2nd_row_base + i, col_white
            else
                SendMIDINoteOn sl_ch, led_2nd_row_base + i, col_dim_white
            endif
        else
            SendMIDINoteOn sl_ch, led_2nd_row_base + i, col_off
        endif
    endfor

    for i = 0 to 15
        idx=(active_page*8 + active_focus)*16 + i
        if pad_ch[idx] > 0
            SendMIDINoteOn sl_ch, led_pad_base + i, pad_color[idx]
        else
            SendMIDINoteOn sl_ch, led_pad_base + i, col_off
        endif
    endfor

    // Codegen-emitted dispatch to per-(page, focus) label renderer
    {{LABEL_DISPATCH}}
@End

// {{LABEL_HANDLERS}}

@UpdateKnobScreen
    sx[0]=0xF0
    sx[1]=0x00
    sx[2]=0x20
    sx[3]=0x29
    sx[4]=0x02
    sx[5]=0x0A
    sx[6]=0x01
    sx[7]=0x02
    sx[8]=knob_idx
    sx[9]=0x03
    sx[10]=0x00
    sx[11]=new_val
    sx[12]=0xF7
    SendSysex sx, 13
@End

@UpdateFaderScreen
    sx[0]=0xF0
    sx[1]=0x00
    sx[2]=0x20
    sx[3]=0x29
    sx[4]=0x02
    sx[5]=0x0A
    sx[6]=0x01
    sx[7]=0x02
    sx[8]=fader_idx + 4
    sx[9]=0x03
    sx[10]=0x00
    sx[11]=val
    sx[12]=0xF7
    SendSysex sx, 13

    led_color=col_off
    if val >= 16
        led_color=col_dim_green
    endif
    if val >= 48
        led_color=col_green
    endif
    if val >= 96
        led_color=col_yellow
    endif
    if val >= 120
        led_color=col_red
    endif
    SendMIDINoteOn sl_ch, led_fader_base + fader_idx, led_color
@End
